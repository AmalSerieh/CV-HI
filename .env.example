# Resume Intelligence Platform
# All settings are optional because the application has safe local defaults.
# Copy this file to .env. Never commit the resulting .env file.

# Web server: loopback-only, debug off. Set APP_RELOAD=false for production-like use.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
APP_RELOAD=true

# Private runtime storage and enforced web limits.
RESUME_PUBLIC_ABSOLUTE_PATHS=false
RESUME_TEMP_DIR=runtime/temp
RESUME_OUTPUT_DIR=runtime/outputs
RESUME_RESULT_TTL_MINUTES=60
RESUME_MAX_UPLOAD_MB=10
RESUME_MAX_PAGES=20
RESUME_MAX_EXTRACTED_CHARS=200000
RESUME_MAX_JOB_DESCRIPTION_CHARS=30000
RESUME_MAX_CONCURRENT_ANALYSES=1
RESUME_MAX_DOCX_UNCOMPRESSED_MB=100
RESUME_MAX_DOCX_FILES=2048

RESUME_ENABLE_TARGET_ROLE=true
RESUME_ENABLE_RECOMMENDATIONS=true
RESUME_ENABLE_ATS=true
RESUME_ENABLE_REWRITES=false
RESUME_ENABLE_OCR=true
RESUME_REWRITE_SECTIONS=summary,experience,skills
RESUME_REWRITE_LANGUAGE=
RESUME_REWRITE_MAX_BULLETS=20
RESUME_REWRITE_ABSOLUTE_MAX_BULLETS=20
RESUME_REWRITE_BULLET_SELECTION=
RESUME_REWRITE_ALL_BULLETS=false
RESUME_REWRITE_MAX_INPUT_CHARS=12000

RESUME_USE_SPACY=false
RESUME_USE_SBERT=false
RESUME_ALLOW_MODEL_DOWNLOAD=false
RESUME_MAX_PROMPT_CHARACTERS=50000
RESUME_MAX_MODEL_OUTPUT_CHARACTERS=50000
RESUME_MAX_SUMMARY_CHARACTERS=800
RESUME_MAX_BULLET_CHARACTERS=500

# Optional local AI. "none" requires no model or external service.
# For Ollama, set provider=ollama and model=gemma3:4b after pulling the model.
RESUME_AI_PROVIDER=none
RESUME_AI_MODEL=
RESUME_AI_TIMEOUT_SECONDS=60
RESUME_AI_CONNECT_TIMEOUT_SECONDS=5
RESUME_AI_WARMUP=false
RESUME_AI_WARMUP_TIMEOUT_SECONDS=120
RESUME_AI_RECOMMENDATION_TIMEOUT_SECONDS=120
RESUME_AI_REWRITE_TIMEOUT_SECONDS=90
RESUME_AI_MAX_RETRIES=1
RESUME_AI_RETRY_TIMEOUTS=false
RESUME_AI_TEMPERATURE=0
RESUME_AI_SEED=42
RESUME_AI_MAX_TOKENS=900
RESUME_RECOMMENDATION_MAX_OUTPUT_TOKENS=224
RESUME_REWRITE_MAX_OUTPUT_TOKENS=256
RESUME_SUMMARY_REWRITE_MAX_OUTPUT_TOKENS=384
RESUME_BULLET_REWRITE_MAX_OUTPUT_TOKENS=256
RESUME_SKILLS_REWRITE_MAX_OUTPUT_TOKENS=768
# Keep large CPU-mode skill lists on the deterministic grouping path.
RESUME_SKILLS_REWRITE_AI_MAX_ITEMS=24
RESUME_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESUME_OLLAMA_NUM_CTX=4096
RESUME_OLLAMA_KEEP_ALIVE=10m
RESUME_OLLAMA_CANCEL_COOLDOWN_SECONDS=2
RESUME_RECOMMENDATION_MAX_SKILLS=16
RESUME_RECOMMENDATION_MAX_EXPERIENCE_ENTRIES=4
RESUME_RECOMMENDATION_MAX_BULLETS_PER_EXPERIENCE=2
RESUME_RECOMMENDATION_MAX_PROJECTS=3
RESUME_RECOMMENDATION_MAX_FIELD_CHARACTERS=400
RESUME_RECOMMENDATION_MAX_PROMPT_CHARACTERS=8000
RESUME_RECOMMENDATION_MAX_EVIDENCE_RECORDS=10
# Optional local Transformers cache; only used by explicit NLP/model tooling.
RESUME_TRANSFORMERS_CACHE_DIR=runtime/model_cache

# Optional OCR. TESSERACT_CMD and TESSDATA_PREFIX may remain empty when auto-detected.
TESSERACT_CMD=
TESSERACT_LANGUAGES=eng+ara
TESSDATA_PREFIX=
